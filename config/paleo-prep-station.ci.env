# Alternate verification profile for scripts/verify-lifecycle.sh.
#
# Same resource boundary shape as config/paleo-prep-station.env (every value
# positive, read header timeout <= read timeout), but on a different address
# with deliberately tighter timeouts. A full round of workflow checks must
# pass against this profile unchanged: parameterisation must not depend on the
# historical literal values, and tightening the boundary must not be allowed to
# change any workflow result.
PPS_ADDR=127.0.0.1:18153
PPS_READ_HEADER_TIMEOUT=2s
PPS_READ_TIMEOUT=10s
PPS_WRITE_TIMEOUT=10s
PPS_IDLE_TIMEOUT=30s
PPS_SHUTDOWN_TIMEOUT=2s

# Probe resources: distinct catalog prefix so repeated runs against a shared
# server never collide on the unique catalog number invariant.
PPS_PROBE_BASE_URL=http://127.0.0.1:18153
PPS_PROBE_REQUEST_TIMEOUT=3s
PPS_PROBE_CATALOG_NUMBER=PPS-CI-001
