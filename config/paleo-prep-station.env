# Canonical runtime configuration for the paleo prep station.
#
# Source this file (or export the variables) before starting the server and
# its workflow checks. Every variable can be overridden by the matching
# command-line flag; see `--help` on either binary.
#
# The values below are identical to the historical built-in defaults, so
# applying this file changes nothing about runtime behaviour. Adjust them
# per environment without touching code.

# --- long-lived HTTP process ---
# Listen address (host:port).
PPS_ADDR=127.0.0.1:18133
# Maximum time spent reading request headers.
PPS_READ_HEADER_TIMEOUT=5s
# Maximum time spent reading the whole request (must be >= header timeout).
PPS_READ_TIMEOUT=15s
# Maximum time spent writing a response.
PPS_WRITE_TIMEOUT=15s
# Idle timeout between keep-alive requests.
PPS_IDLE_TIMEOUT=60s
# Grace period for in-flight requests on SIGINT/SIGTERM.
PPS_SHUTDOWN_TIMEOUT=5s

# --- workflow probe resources ---
# workflowcheck never starts its own listener; it targets a running server.
PPS_PROBE_BASE_URL=http://127.0.0.1:18133
# Bound each individual probe HTTP request.
PPS_PROBE_REQUEST_TIMEOUT=5s
# Catalog number the probe registers. Concurrent probes must each use a
# distinct value to respect the unique catalog number business invariant.
PPS_PROBE_CATALOG_NUMBER=PPS-2026-001
